managed implementation in class zbp_i_at_att unique;
strict ( 2 );
with draft;

define behavior for ZI_AT_ATT alias Attendance
persistent table zat_att
draft table ZAT_ATTD
lock master total etag last_changed_at
authorization master ( global )
//etag master <field_name>
{
  field(mandatory) attendanceStart, employeeId;
  field(readonly, numbering : managed) attendanceId;

  create;
  update;
  delete;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
}