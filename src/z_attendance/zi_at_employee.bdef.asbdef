managed implementation in class zbp_i_at_employee unique;
strict ( 2 );
with draft;

define behavior for ZI_AT_EMPLOYEE alias Employee
persistent table zat_employee
draft table ZAT_EMPLOYEED
lock master total etag last_changed_at
authorization master ( global )
//etag master <field_name>
{
  field ( readonly, numbering : managed ) employeeID;
  field ( mandatory : create ) name, email, departmentID;

  create;
  update;
  delete;
  association _Contracts { create; }
  association _Department;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

}

define behavior for ZI_AT_CONTRACT alias Contract
persistent table zat_contract
draft table ZAT_CONTRACTD
lock dependent by _Employee
authorization dependent by _Employee
//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) employeeID;
  field ( readonly, numbering : managed ) contractID;
  association _Employee;
}