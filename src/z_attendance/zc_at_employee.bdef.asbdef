projection;
strict ( 2 );
use draft;

define behavior for ZC_AT_EMPLOYEE alias Employee
{
  use create;
  use update;
  use delete;

  use  association _Contracts; //{ create; with draft;}
  use association _Department;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}